# ─── Backend ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ayasrah_db
DB_USER=ayasrah_user
DB_PASSWORD=your_secure_password_here

# ─── Auth ──────────────────────────────────────────────────
