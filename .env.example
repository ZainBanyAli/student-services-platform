# ─── Admin Seed (used only during initial DB seed) ─────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_before_seeding

# ─── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
